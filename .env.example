# ============================================================================
# Diffwise environment variables  (see docs/setup.md)
# Injected as Railway service variables in production; NEVER commit real values.
# Names are the reconciled canonical set (tech-spec §2.7 + §3.3 + §4.6 + §10.7).
# ============================================================================

# Postgres connection string (Railway Postgres plugin reference).
DATABASE_URL=postgres://user:password@host:5432/diffwise

# AES-256-GCM master key: a base64-encoded 32-byte key. Source of ALL secret
# encryption. Never stored in the DB or git. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=

# Optional older master keys for rotation windows (crypto.ts key registry).
# ENCRYPTION_MASTER_KEY_V2=
# ENCRYPTION_MASTER_KEY_V3=

# GitHub OAuth App credentials (identity + repo-read token). The secret is
# server-only and never sent to the browser.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# https://<app-host>/api/auth/github/callback
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Public app origin (used for OAuth redirects and absolute URLs).
APP_BASE_URL=http://localhost:3000

# Optional: secret for signing the session cookie (only if cookie signing is on).
# SESSION_COOKIE_SECRET=

# Pinned Anthropic model (config, not user-settable). BYOK = no ANTHROPIC_API_KEY.
ANTHROPIC_MODEL=claude-opus-4-8

# Hard PR size cap: additions + deletions. PRs above this are rejected.
DIFFWISE_MAX_CHANGED_LINES=10000

# Rate limiting / capacity (§10.7).
MAX_CONCURRENT_GENERATIONS=4
RATE_LIMIT_GEN_PER_MIN=3
RATE_LIMIT_GEN_PER_HOUR=30

NODE_ENV=development
